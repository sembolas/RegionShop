# Django
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# База данных PostgreSQL
DATABASE_URL=postgres://regionshop_user:regionshop_password@localhost:5432/regionshop

# CORS настройки
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 1С интеграция (OData)
ONEC_BASE_URL=http://1c-server/base
ONEC_USER=username
ONEC_PASSWORD=password
ONEC_SYNC_INTERVAL=300  # интервал синхронизации в секундах (5 минут)

# JWT аутентификация
JWT_ACCESS_LIFETIME=60      # минуты
JWT_REFRESH_LIFETIME=1440   # минуты (24 часа)

# Redis для кэширования и Celery
REDIS_URL=redis://localhost:6379/0

# Email настройки (для production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Логирование
LOG_LEVEL=INFO

# Медиа файлы
MEDIA_URL=/media/
MEDIA_ROOT=/app/media/

# Статические файлы
STATIC_URL=/static/
STATIC_ROOT=/app/static/